# Diese Werte in Railway unter "Variables" eintragen:
ANTHROPIC_API_KEY=dein_claude_api_key
# Optional, Standard ist claude-opus-5-5
ANTHROPIC_MODEL=claude-opus-5-5

# Zugangsschutz fuer Dashboard und API (Pflicht, sonst bleibt der Agent gesperrt):
AGENT_BENUTZER=soraya
AGENT_PASSWORT=ein_langes_zufaelliges_passwort

# Tagesplan (alle optional):
# 1 = jeden Morgen automatisch, 0 = nur per Knopf im Dashboard
TAGESPLAN_AUTO=1
TAGESPLAN_SPRACHEN=de,en,hu,it
# ab dieser Stunde (Wiener Zeit)
TAGESPLAN_STUNDE=6

# Wirkung messen: derselbe geheime Wert wie beim Dienst astro-engine (mind. 24 Zeichen).
# Das Dashboard erzeugt dir unter "Wirkung" einen passenden Wert.
AGENT_STATS_TOKEN=

# Adresse der astro-engine (nur aendern, wenn sie umzieht)
ENGINE_URL=https://astro-engine-production-7b18.up.railway.app

# DATABASE_URL wird von Railway automatisch gesetzt, sobald du die
# PostgreSQL-Datenbank mit dem Service verbindest — nicht selbst eintippen.
