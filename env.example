# Diese Werte in Railway unter "Variables" eintragen:
ANTHROPIC_API_KEY=dein_claude_api_key
# Optional, Standard ist claude-opus-5-5
ANTHROPIC_MODEL=claude-opus-5-5

# Zugangsschutz fuer Dashboard und API (Pflicht, sonst bleibt der Agent gesperrt):
AGENT_BENUTZER=soraya
AGENT_PASSWORT=ein_langes_zufaelliges_passwort

# Tagesplan (alle optional):
# Die Automatik schaltest du im Dashboard (Heute -> "Jeden Morgen automatisch erstellen", Standard: aus).
# TAGESPLAN_AUTO=0 sperrt sie zusaetzlich ganz, dann wirkt auch der Schalter nicht.
# TAGESPLAN_AUTO=0
TAGESPLAN_SPRACHEN=de,en,hu,it
# ab dieser Stunde (Wiener Zeit)
TAGESPLAN_STUNDE=6

# Wirkung messen: derselbe geheime Wert wie beim Dienst astro-engine (mind. 24 Zeichen).
# Das Dashboard erzeugt dir unter "Wirkung" einen passenden Wert.
AGENT_STATS_TOKEN=
# Wohin die Post- und Bio-Links zeigen (Landingpage); nur aendern, wenn die Domain wechselt
LINK_BASIS=https://www.sorayaluxuryastroguide.com/

# Adresse der astro-engine (nur aendern, wenn sie umzieht)
ENGINE_URL=https://astro-engine-production-7b18.up.railway.app

# Bilder und Reel-Videos zeichnet der Agent selbst (Pillow + ffmpeg aus imageio-ffmpeg),
# dafuer ist nichts einzutragen. Fertige Medien bleiben 21 Tage in der Datenbank.

# Automatisch posten (Facebook-Seite + Instagram) -- Werte aus developers.facebook.com,
# NIE in einen Chat kopieren. Ohne diese Werte bleibt "Verbinden" im Dashboard aus.
# META_APP_ID=
# META_APP_SECRET=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# optional: META_API_VERSION=v24.0, META_PAGE_ID=<id der Seite>, AGENT_URL=https://<eigene-domain>

# DATABASE_URL wird von Railway automatisch gesetzt, sobald du die
# PostgreSQL-Datenbank mit dem Service verbindest — nicht selbst eintippen.

# TikTok (nur Reels) -- Werte aus developers.tiktok.com (Login Kit + Content Posting API)
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# LinkedIn (persoenliches Profil) -- Werte aus linkedin.com/developers
# (Produkte "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn")
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# optional: LINKEDIN_VERSION=JJJJMM, LINKEDIN_KI=0 (Text ohne KI nur aufraeumen statt sachlich umschreiben)
